# ==========================================
# CONFIGURACIÓN DE GOOGLE SHEETS API V4
# ==========================================
# ID de la hoja de cálculo extraído de la URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=tu_spreadsheet_id_aqui

# Correo electrónico de la cuenta de servicio (Google Cloud Service Account)
# Ejemplo: mi-servicio@mi-proyecto.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=tu_service_account_email@proyecto.iam.gserviceaccount.com

# Clave privada RSA de la cuenta de servicio (incluyendo cabecera y saltos \n)
# Ejemplo: "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_clave_privada_aqui\n-----END PRIVATE KEY-----\n"

# NOTA: Asegúrate de compartir el documento de Google Sheets con el correo de tu
# cuenta de servicio (GOOGLE_CLIENT_EMAIL) con permisos de "Lector" o "Viewer".
